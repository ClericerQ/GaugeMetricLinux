#!/bin/bash

# Usage:
#   sysinfo                          interactive terminal view
#   sysinfo json                     all local sections as JSON
#   sysinfo json cpu mem net ...     only the given sections
#
# Sections: system cpu temp mem disk gpu diskio net wan smart
#
# "wan" (public IP and latency) sends a request to the internet and is only
# included when asked for by name - a plain "sysinfo json" stays offline.
# SYSINFO_WAN_URL overrides the server, SYSINFO_WAN_TIMEOUT its timeout (s).
#
# "smart" runs smartctl -a on every physical drive (needs root or a sudo rule
# for smartctl). Sleeping hard disks are not woken up (-n standby). Like wan it
# is only included when asked for by name: a call can take seconds.
# SYSINFO_SMART_DEVICES="sda nvme0n1" limits it to these drives,
# SYSINFO_SMART_TIMEOUT the time per drive (s), SYSINFO_SMART_DESIGN_HOURS
# the assumed service life of a hard disk for the lifetime estimate.
#
# SYSINFO_STATE_DIR=/some/dir keeps the counter state for the rate values
# (cpu, diskio, net) in that directory. A background poller sets it so that
# every value covers exactly the time since its previous call - and so that
# an interactive sysinfo running at the same time does not skew its rates.

WAN_URL="${SYSINFO_WAN_URL:-https://dirin.eu/wanip/index.php}"
WAN_TIMEOUT="${SYSINFO_WAN_TIMEOUT:-3}"

SMART_DEVICES="${SYSINFO_SMART_DEVICES:-}"
SMART_TIMEOUT="${SYSINFO_SMART_TIMEOUT:-10}"
# 5 years of continuous operation - the usual warranty of NAS and server disks
SMART_DESIGN_HOURS="${SYSINFO_SMART_DESIGN_HOURS:-43800}"

STATE_DIR="${SYSINFO_STATE_DIR:-}"
if [ -n "$STATE_DIR" ]; then
    mkdir -p "$STATE_DIR" 2>/dev/null
    DISK_STATE="$STATE_DIR/disk_stat_state"
    NET_STATE="$STATE_DIR/net_stat_state"
    CPU_STATE="$STATE_DIR/cpu_stat_state"
else
    DISK_STATE=/tmp/disk_stat_state
    NET_STATE=/tmp/net_stat_state
    CPU_STATE=""
fi

# --- Helpers ---

json_escape() {
    local s=$1
    s=${s//\\/\\\\}
    s=${s//\"/\\\"}
    printf '%s' "$s"
}

human_rate() {
    # bytes/s -> "12.34 KB/s" / "1.23 MB/s"
    awk -v b="$1" 'BEGIN { k=b/1024; if (k > 1024) printf "%.2f MB/s", k/1024; else printf "%.2f KB/s", k }'
}

# --- Data Gathering Functions ---

get_system_info() {
    # Returns: hostname|kernel|uptime_s|load1|load5|load15|cpu_model|os
    local host kernel up load model os
    read -r host < /proc/sys/kernel/hostname
    read -r kernel < /proc/sys/kernel/osrelease
    read -r up _ < /proc/uptime
    read -r l1 l5 l15 _ < /proc/loadavg
    model=$(awk -F': ' '/^model name/ { print $2; exit }' /proc/cpuinfo)
    os=$( . /etc/os-release 2>/dev/null; echo "$PRETTY_NAME")
    echo "$host|$kernel|$up|$l1|$l5|$l15|$model|$os"
}

get_cpu_mhz() {
    grep "cpu MHz" /proc/cpuinfo | awk '{print $4}'
}

get_cpu_temp() {
    # Returns: label|value  e.g. "Package id 0|53.0°C"
    # Reads hwmon directly, so it also works without lm-sensors installed.
    local h name t base label val key found=0
    declare -A seen
    for h in /sys/class/hwmon/hwmon*; do
        [ -r "$h/name" ] || continue
        read -r name < "$h/name"
        for t in "$h"/temp*_input; do
            [ -r "$t" ] || continue
            base=${t%_input}
            label=""
            [ -r "${base}_label" ] && read -r label < "${base}_label"
            read -r val < "$t" 2>/dev/null || continue
            case "$name" in
                coretemp|k10temp|zenpower|cpu_thermal) key=${label:-$name} ;;
                *) key="$name${label:+ $label}" ;;
            esac
            # Several chips of the same kind (e.g. two NVMe drives) share a name.
            if [ -n "${seen[$key]}" ]; then
                seen[$key]=$(( ${seen[$key]} + 1 ))
                key="$key #${seen[$key]}"
            else
                seen[$key]=1
            fi
            awk -v k="$key" -v v="$val" 'BEGIN { printf "%s|%.1f°C\n", k, v/1000 }'
            found=1
        done
    done
    if [ $found -eq 0 ]; then
        sensors 2>/dev/null | awk -F: '/^(Package id|Core|Tctl|Tdie)/ { v=$2; sub(/^[ \t]*\+?/, "", v); sub(/[ \t(].*/, "", v); print $1 "|" v }'
    fi
}

get_mem_info() {
    # Force English locale (LC_ALL=C) so "Mem:" is always found regardless of system language
    LC_ALL=C free -h | awk '/^Mem:/ {print $2, $3, $7}'
}

get_mem_bytes() {
    # Returns: total used free buff/cache available swap_total swap_used (bytes)
    LC_ALL=C free -b | awk '/^Mem:/ { m=$2" "$3" "$4" "$6" "$7 } /^Swap:/ { s=$2" "$3 } END { print m, s }'
}

get_disk_usage() {
    # Returns: Total Used Free (for the root filesystem)
    df -h / | awk 'NR==2 {print $2, $3, $4}'
}

get_filesystems() {
    # Returns: device|fstype|size|used|avail|mount (bytes) for every real filesystem.
    # timeout: a hanging network mount must not block the whole call.
    LC_ALL=C timeout 3 df -B1 -P -T -x tmpfs -x devtmpfs -x squashfs -x overlay \
        -x efivarfs -x ramfs -x fuse.lxcfs 2>/dev/null |
        awk 'NR > 1 && $3 > 0 && !seen[$1]++ {
                mnt=$7; for (i=8; i<=NF; i++) mnt=mnt" "$i;
                printf "%s|%s|%s|%s|%s|%s\n", $1, $2, $3, $4, $5, mnt
             }'
}

get_gpu_info() {
    # Returns: name|temp|power|util|index|mem_used_bytes|mem_total_bytes|power_limit_w|fan_percent|pstate|driver
    # The first four keep their old form ("53C", "120.5W", "30%"). The rest are
    # plain numbers, empty where the card answers [N/A] - e.g. no own VRAM on
    # unified memory systems, no fan on passively cooled cards.
    command -v nvidia-smi >/dev/null 2>&1 || return 0
    # name last: it is the only field that could ever contain a comma.
    # timeout: a wedged driver makes nvidia-smi hang instead of failing.
    LC_ALL=C timeout 3 nvidia-smi \
        --query-gpu=index,temperature.gpu,power.draw,utilization.gpu,memory.used,memory.total,power.limit,fan.speed,pstate,driver_version,name \
        --format=csv,noheader,nounits 2>/dev/null |
        awk -F', *' '
        function n(v) { return v ~ /^[0-9]+(\.[0-9]+)?$/ ? v : "" }
        function mib(v) { return n(v) == "" ? "" : sprintf("%.0f", v * 1048576) }
        # Driver errors ("NVIDIA-SMI has failed ...") also go to stdout
        NF >= 11 && $1 ~ /^[0-9]+$/ {
            name = $11; for (i = 12; i <= NF; i++) name = name ", " $i;
            printf "%s|%sC|%sW|%s%%|%s|%s|%s|%s|%s|%s|%s\n", name, $2, $3, $4, $1,
                mib($5), mib($6), n($7), n($8), $9, $10
        }'
}

smart_devices() {
    # Physical drives: block devices backed by real hardware. Partitions,
    # device mapper, md, loop, ram and optical drives have no SMART data.
    if [ -n "$SMART_DEVICES" ]; then
        printf '%s\n' $SMART_DEVICES
        return
    fi
    local d n rem
    for d in /sys/block/*; do
        n=${d##*/}
        [ -e "$d/device" ] || continue
        case "$n" in loop*|ram*|zram*|dm-*|md*|nbd*|rbd*|sr*|fd*) continue ;; esac
        # Hidden NVMe multipath paths (nvme0c0n1) - the namespace nvme0n1 is listed anyway
        [[ "$n" =~ ^nvme[0-9]+c[0-9]+n ]] && continue
        # Card readers and USB sticks: removable, no SMART
        rem=0
        [ -r "$d/removable" ] && read -r rem < "$d/removable"
        [ "$rem" == "1" ] && continue
        echo "$n"
    done
}

smart_parse() {
    # Reads the output of "smartctl -a" and prints one line:
    # device|kind|model|serial|firmware|capacity_bytes|rpm|health|temp_c|
    # power_on_hours|power_cycles|read_bytes|written_bytes|life_used_percent|
    # spare_percent|spare_threshold|reallocated|pending|uncorrectable|
    # unused_reserve_blocks|media_errors|unsafe_shutdowns|remaining_hours|basis|state|error
    #
    # Text instead of "smartctl -j": JSON needs smartmontools 7 and a parser
    # (jq) that is not installed everywhere; the text labels have been stable
    # for many versions. Missing values stay empty.
    awk -v dev="$1" -v rc="$2" -v rota="$3" -v size="$4" -v design="$SMART_DESIGN_HOURS" '
    function after(s) { sub(/^[^:]*:[ \t]*/, "", s); return s }
    # First number of a value, thousands separators removed ("12,345,678 [6.32 TB]")
    function num(s) { gsub(/,/, "", s); return match(s, /[0-9]+(\.[0-9]+)?/) ? substr(s, RSTART, RLENGTH) : "" }
    function clean(s) { gsub(/\|/, "/", s); sub(/[ \t\r]+$/, "", s); return s }
    function setonce(key, v) { if (!(key in d) && v != "") d[key] = v }
    # Unit of a vendor-specific ATA read/write counter, from its name
    function unit(name) {
        if (name ~ /NAND|Flash/) return 0
        if (name ~ /32MiB$/)     return 33554432
        if (name ~ /GiB$/)       return 1073741824
        if (name ~ /MiB$/)       return 1048576
        if (name ~ /GB$/)        return 1000000000
        if (name ~ /LBA|Sector/)  return -1
        return 0
    }

    BEGIN { lss = 512 }

    /^Device Model:|^Model Number:/    { setonce("model", clean(after($0))) }
    /^Vendor:/                         { vendor = clean(after($0)) }
    /^Product:/                        { setonce("model", clean(after($0))) }
    /^Serial [Nn]umber:/               { setonce("serial", clean(after($0))) }
    /^Firmware Version:|^Revision:/    { setonce("firmware", clean(after($0))) }
    /^User Capacity:|^Total NVM Capacity:|^Namespace 1 Size\/Capacity:/ {
        v = after($0); sub(/\[.*/, "", v); gsub(/[^0-9]/, "", v)
        if (v + 0 > 0) setonce("capacity", v)
    }
    /^Rotation Rate:/                  { v = after($0); d["rpm"] = (v ~ /Solid State/) ? 0 : num(v) }
    /^Sector Sizes?:/                  { if (match($0, /[0-9]+ bytes logical/)) lss = substr($0, RSTART, RLENGTH) + 0 }
    /^NVMe Version:|^=== START OF .*NVMe/ { iface = "nvme" }
    /^ATA Version is:|^SATA Version is:/  { iface = "ata" }
    /^Transport protocol:/             { iface = "scsi" }

    # Health: ATA/NVMe "test result: PASSED", SCSI "SMART Health Status: OK"
    /self-assessment test result:/     { d["health"] = clean(after($0)) }
    /^SMART Health Status:/            { d["health"] = clean(after($0)) }

    # NVMe health log
    /^Temperature:/                    { setonce("temp", num(after($0))) }
    /^Available Spare:/                { d["spare"] = num(after($0)) }
    /^Available Spare Threshold:/      { d["spare_thr"] = num(after($0)) }
    /^Percentage Used:/                { d["life_used"] = num(after($0)) }
    # One data unit = 1000 blocks of 512 bytes
    /^Data Units Read:/                { d["read"] = num(after($0)) * 512000 }
    /^Data Units Written:/             { d["written"] = num(after($0)) * 512000 }
    /^Power Cycles:/                   { d["cycles"] = num(after($0)) }
    /^Power On Hours:/                 { d["poh"] = num(after($0)) }
    /^Unsafe Shutdowns:/               { d["unsafe"] = num(after($0)) }
    /^Media and Data Integrity Errors:/ { d["media"] = num(after($0)) }

    # SCSI / SAS
    /^Current Drive Temperature:/      { setonce("temp", num(after($0))) }
    /^Accumulated power on time/       { v = $0; sub(/.*[ \t]/, "", v); split(v, hm, ":"); d["poh"] = hm[1] + 0 }
    /^Accumulated start-stop cycles:/  { setonce("cycles", num(after($0))) }
    /^Percentage used endurance indicator:/ { d["life_used"] = num(after($0)) }
    /^Elements in grown defect list:/  { d["realloc"] = num(after($0)) }
    # Error counter log: next to last column = gigabytes processed (10^9 bytes)
    /^read:/  && NF >= 8               { d["read"] = $(NF - 1) * 1000000000 }
    /^write:/ && NF >= 8               { d["written"] = $(NF - 1) * 1000000000 }

    # ATA attribute table: ID NAME FLAG VALUE WORST THRESH TYPE UPDATED WHEN_FAILED RAW
    $1 ~ /^[0-9]+$/ && $3 ~ /^0x[0-9a-f]+$/ && NF >= 10 {
        iface = "ata"
        name = $2; value = $4 + 0; worst = $5 + 0; thresh = $6 + 0
        raw = match($10, /^[0-9]+/) ? substr($10, RSTART, RLENGTH) + 0 : ""

        if (name ~ /^Power_On_Hours/)            d["poh"] = raw
        else if (name == "Power_On_Minutes")     d["poh"] = int(raw / 60)
        else if (name == "Power_On_Seconds")     d["poh"] = int(raw / 3600)
        else if (name == "Power_On_Half_Minutes") d["poh"] = int(raw / 120)
        else if (name == "Power_Cycle_Count")    d["cycles"] = raw
        else if (name ~ /^Temperature_(Celsius|Internal|Case)$/) d["temp"] = raw
        else if (name == "Airflow_Temperature_Cel") airflow = raw
        else if (name == "Reallocated_Sector_Ct") {
            d["realloc"] = raw
            # Normalized value counts down from 100 (WD: 200) to the vendor
            # threshold as spare sectors are used up.
            start = (value > 100 || worst > 100) ? 200 : 100
            if (start > thresh) realloc_spare = (value - thresh) * 100 / (start - thresh)
        }
        else if (name == "Current_Pending_Sector") d["pending"] = raw
        else if (name == "Offline_Uncorrectable")  d["uncorr"] = raw
        else if (name ~ /^(Available_Reservd_Space|Available_Reserve_Space|Unused_Rsvd_Blk_Cnt_Tot|Unused_Reserve_NAND_Blk)$/) {
            if (!("spare" in d)) { d["spare"] = value > 100 ? 100 : value; d["spare_thr"] = thresh }
            if (name ~ /^Unused/) d["unused"] = raw
        }
        # Remaining life in percent - the normalized value, name depends on the vendor
        else if (name ~ /^(Percent_Lifetime_Remain|Remaining_Lifetime_Perc|Percent_Life_Remaining|SSD_Life_Left|Media_Wearout_Indicator|Wear_Leveling_Count)$/) {
            prio = (name ~ /^Percent|^Remaining/) ? 1 : (name == "Wear_Leveling_Count") ? 3 : 2
            if (!life_prio || prio < life_prio) { life_prio = prio; d["life_used"] = 100 - (value > 100 ? 100 : value) }
        }
        else if (name ~ /^(Total|Host|Lifetime)_/ && name ~ /Writ|Read/) {
            u = unit(name)
            if (u != 0) {
                bytes = raw * (u < 0 ? lss : u)
                if (name ~ /Writ/) setonce("written", bytes); else setonce("read", bytes)
            }
        }
    }

    { text = text "\n" $0 }

    END {
        if (!("temp" in d) && airflow != "") d["temp"] = airflow
        if (!("spare" in d) && realloc_spare != "") { d["spare"] = sprintf("%.0f", realloc_spare); d["spare_thr"] = 0 }
        if (vendor != "" && ("model" in d) && index(d["model"], vendor) != 1) d["model"] = vendor " " d["model"]
        if (!("capacity" in d) && size > 0) d["capacity"] = size
        if (iface == "" && dev ~ /^nvme/) iface = "nvme"

        rpm = ("rpm" in d) ? d["rpm"] : ""
        if (iface == "nvme")    kind = "nvme"
        else if (rpm != "")     kind = (rpm == 0) ? "ssd" : "hdd"
        else if (rota != "")    kind = (rota == 1) ? "hdd" : "ssd"
        else                    kind = ""

        state = "active"; err = ""
        if (text ~ /Device is in (STANDBY|SLEEP|IDLE)/)                     state = "standby"
        else if (rc == 124)                                                 err = "timeout"
        else if (text ~ /Permission denied|Operation not permitted|must be root/) err = "permission"
        else if (text ~ /No such (device|file)/)                           err = "missing"
        else if (text ~ /SMART support is:[ \t]*Disabled/)                 err = "disabled"
        else if (text ~ /Unable to detect device type|Unknown USB bridge|SMART support is:[ \t]*Unavailable|lacks SMART capability/) err = "unsupported"
        else if (!("poh" in d) && !("health" in d))                        err = (rc > 0) ? "rc-" rc : "no-data"
        if (err != "") state = "error"

        # Theoretical remaining lifetime: extrapolate from wear and from used
        # spare sectors at the rate seen so far; hard disks have no wear gauge,
        # there the assumed service life counts. The shortest estimate wins.
        rem = ""; basis = ""
        poh = ("poh" in d) ? d["poh"] + 0 : -1
        if (poh > 0 && ("life_used" in d)) {
            lu = d["life_used"] + 0
            if (lu >= 100)   { rem = 0; basis = "wear" }
            else if (lu > 0) { rem = poh * (100 - lu) / lu; basis = "wear" }
        }
        if (poh > 0 && ("spare" in d)) {
            sp = d["spare"] + 0; thr = d["spare_thr"] + 0
            if (sp <= thr)      { rem = 0; basis = "spare" }
            else if (sp < 100)  { r = poh * (sp - thr) / (100 - sp); if (rem == "" || r < rem) { rem = r; basis = "spare" } }
        }
        if (poh >= 0 && kind == "hdd" && design > 0) {
            r = design - poh; if (r < 0) r = 0
            if (rem == "" || r < rem) { rem = r; basis = "design" }
        }
        if (rem != "") rem = sprintf("%.0f", rem)

        printf "%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s\n",
            dev, kind, d["model"], d["serial"], d["firmware"], d["capacity"], rpm, d["health"], d["temp"],
            d["poh"], d["cycles"],
            ("read" in d) ? sprintf("%.0f", d["read"]) : "", ("written" in d) ? sprintf("%.0f", d["written"]) : "",
            d["life_used"], d["spare"], d["spare_thr"], d["realloc"], d["pending"], d["uncorr"], d["unused"],
            d["media"], d["unsafe"], rem, basis, state, err
    }'
}

get_smart_info() {
    # First line: smartctl_version|error, then one smart_parse line per drive.
    # The drives are queried in parallel: a slow USB bridge or a disk that
    # takes a second per query must not add up over a dozen disks.
    local path ver cmd=() tmp dev rota size
    path=$(command -v smartctl 2>/dev/null)
    if [ -z "$path" ]; then
        echo "|no-smartctl"
        return 0
    fi
    ver=$(LC_ALL=C "$path" -V 2>/dev/null | awk 'NR == 1 { print $2 }')

    cmd=("$path")
    # Not root: a sudo rule for smartctl alone (NOPASSWD) is enough
    if [ "$(id -u)" -ne 0 ]; then
        if command -v sudo >/dev/null 2>&1 && sudo -n -l "$path" >/dev/null 2>&1; then
            cmd=(sudo -n "$path")
        fi
    fi
    echo "$ver|"

    tmp=$(mktemp -d 2>/dev/null) || return 0
    mapfile -t devs < <(smart_devices)
    for dev in "${devs[@]}"; do
        [[ "$dev" =~ ^[A-Za-z0-9._-]+$ ]] || continue
        # -n standby: a spun down disk stays asleep, smartctl reports it instead
        ( LC_ALL=C timeout "$SMART_TIMEOUT" "${cmd[@]}" -a -n standby "/dev/$dev" > "$tmp/$dev.out" 2>&1
          echo $? > "$tmp/$dev.rc" ) &
    done
    wait

    for dev in "${devs[@]}"; do
        [ -f "$tmp/$dev.rc" ] || continue
        rota=""; size=0
        [ -r "/sys/block/$dev/queue/rotational" ] && read -r rota < "/sys/block/$dev/queue/rotational"
        [ -r "/sys/block/$dev/size" ] && read -r size < "/sys/block/$dev/size"
        smart_parse "$dev" "$(cat "$tmp/$dev.rc")" "$rota" "$(( ${size:-0} * 512 ))" < "$tmp/$dev.out"
    done
    rm -rf "$tmp"
}

cpu_snapshot() {
    awk '/^cpu/ { total=$2+$3+$4+$5+$6+$7+$8+$9; idle=$5; print $1, total, idle }' /proc/stat
}

get_cpu_stats() {
    # Returns: name load  ("cpu" = all cores, "cpu0" ... per core)
    # With a state dir the load covers the time since the previous call,
    # otherwise a short 0.2 s sample is taken.
    local prev curr
    if [ -n "$CPU_STATE" ] && [ -f "$CPU_STATE" ]; then
        prev=$(cat "$CPU_STATE")
    else
        prev=$(cpu_snapshot)
        sleep 0.2
    fi
    curr=$(cpu_snapshot)
    [ -n "$CPU_STATE" ] && echo "$curr" > "$CPU_STATE"
    awk 'NR == FNR { pt[$1]=$2; pi[$1]=$3; next }
         {
            dt=$2-pt[$1]; di=$3-pi[$1];
            if (dt > 0) printf "%s %.1f\n", $1, (dt-di)*100/dt; else printf "%s 0.0\n", $1;
         }' <(echo "$prev") <(echo "$curr")
}

get_cpu_load() {
    get_cpu_stats | awk '$1 ~ /^cpu[0-9]/ { print $2 }'
}

get_disk_io() {
    # Returns: device|read_str|write_str|read_bps|write_bps|active_percent
    now=$(date +%s.%N)
    curr_stats=$(awk -v t="$now" '$3 ~ /^(sd[a-z]+|nvme[0-9]+n[0-9]+|vd[a-z]+|xvd[a-z]+|mmcblk[0-9]+)$/ { print $3, $6, $10, t, $13 }' /proc/diskstats)

    if [ ! -f "$DISK_STATE" ]; then
        echo "$curr_stats" > "$DISK_STATE"
        return 1
    fi

    echo "$curr_stats" | awk -v prev_file="$DISK_STATE" '
    BEGIN {
        while ((getline < prev_file) > 0) {
            pr[$1]=$2; pw[$1]=$3; pt[$1]=$4;
            # State files of older sysinfo versions have no I/O time column
            if (NF >= 5) pio[$1]=$5;
        }
    }
    {
        dev=$1; cr=$2; cw=$3; ct=$4; cio=$5;
        if (!(dev in pt)) next;
        dt = ct - pt[dev];
        if (dt > 0) {
            rspeed = (cr - pr[dev]) * 0.5 / dt;
            wspeed = (cw - pw[dev]) * 0.5 / dt;
            if (rspeed < 0) rspeed = 0;
            if (wspeed < 0) wspeed = 0;
            # Field 13 = milliseconds spent doing I/O ("active time" like Windows)
            util = (dev in pio) ? (cio - pio[dev]) / (dt * 10) : 0;
            if (util < 0) util = 0;
            if (util > 100) util = 100;
            rstr = (rspeed > 1024) ? sprintf("%.2f MB/s", rspeed/1024) : sprintf("%.2f KB/s", rspeed);
            wstr = (wspeed > 1024) ? sprintf("%.2f MB/s", wspeed/1024) : sprintf("%.2f KB/s", wspeed);
            printf "%s|%s|%s|%.0f|%.0f|%.1f\n", dev, rstr, wstr, rspeed*1024, wspeed*1024, util;
        }
    }'
    echo "$curr_stats" > "$DISK_STATE"
    return 0
}

get_net_io() {
    # Returns: iface|rx_str|tx_str|rx_bps|tx_bps|rx_total|tx_total|state|speed_mbit|ipv4
    local now curr_stats line iface state speed ipv4
    now=$(date +%s.%N)
    curr_stats=$(awk -v t="$now" 'NR > 2 {
            split($0, a, ":"); iface=a[1]; gsub(/ /, "", iface);
            split(a[2], f, " ");
            if (iface != "lo") print iface, f[1], f[9], t
        }' /proc/net/dev)

    if [ ! -f "$NET_STATE" ]; then
        echo "$curr_stats" > "$NET_STATE"
        return 1
    fi

    declare -A addr
    while read -r _ iface _ cidr _; do
        addr[$iface]="${addr[$iface]:+${addr[$iface]} }$cidr"
    done < <(ip -o -4 addr show 2>/dev/null)

    while IFS='|' read -r iface rest; do
        [ -n "$iface" ] || continue
        state=unknown; speed=-1
        [ -r "/sys/class/net/$iface/operstate" ] && read -r state < "/sys/class/net/$iface/operstate"
        # Virtual interfaces answer speed with EINVAL
        [ -r "/sys/class/net/$iface/speed" ] && read -r speed < "/sys/class/net/$iface/speed" 2>/dev/null
        [[ "$speed" =~ ^-?[0-9]+$ ]] || speed=-1
        echo "$iface|$rest|$state|$speed|${addr[$iface]}"
    done < <(echo "$curr_stats" | awk -v prev_file="$NET_STATE" '
    BEGIN {
        while ((getline < prev_file) > 0) {
            prx[$1]=$2; ptx[$1]=$3; pt[$1]=$4;
        }
    }
    {
        dev=$1; rx=$2; tx=$3; ct=$4;
        if (!(dev in pt)) next;
        dt = ct - pt[dev];
        if (dt > 0) {
            rb = (rx - prx[dev]) / dt;
            tb = (tx - ptx[dev]) / dt;
            # Counter reset (interface re-created) - no negative rates
            if (rb < 0) rb = 0;
            if (tb < 0) tb = 0;
            rstr = sprintf("%.2f Mbit/s", rb * 8 / 1000000);
            tstr = sprintf("%.2f Mbit/s", tb * 8 / 1000000);
            printf "%s|%s|%s|%.0f|%.0f|%s|%s\n", dev, rstr, tstr, rb, tb, rx, tx;
        }
    }')
    echo "$curr_stats" > "$NET_STATE"
    return 0
}

get_wan_info() {
    # Returns: ip|latency_ms|response_ms|error
    # The server answers with the caller's address as plain text. Latency is the
    # TCP handshake - one round trip like ping, which firewalls often drop.
    # The response time adds DNS, TLS and the request itself.
    local out rc code dns conn total ip lat resp err
    if ! command -v curl >/dev/null 2>&1; then
        echo "|||no-curl"
        return
    fi

    # -w still prints after a failed transfer (http_code 000), so the last line
    # is always the timing line and everything before it is the body.
    out=$(curl -s -m "$WAN_TIMEOUT" -H 'Cache-Control: no-cache' \
        -w '\n%{http_code} %{time_namelookup} %{time_connect} %{time_total}' "$WAN_URL" 2>/dev/null)
    rc=$?
    read -r code dns conn total <<< "${out##*$'\n'}"
    ip=${out%$'\n'*}
    [ "$ip" == "$out" ] && ip=""
    ip=${ip//[$' \t\r\n']/}

    case $rc in
        0)  err="" ;;
        6)  err="dns" ;;
        7)  err="connect" ;;
        28) err="timeout" ;;
        35|51|53|54|58|59|60|77|83|90|91) err="tls" ;;
        *)  err="curl-$rc" ;;
    esac
    if [ -z "$err" ] && [ "$code" != "200" ]; then
        err="http-$code"
    fi
    # Anything but a bare address (error page, captive portal) is not our IP.
    if ! [[ "$ip" =~ ^[0-9a-fA-F:.]{2,45}$ && "$ip" =~ [.:] ]]; then
        ip=""
        [ -z "$err" ] && err="no-ip"
    fi

    lat=$(awk -v d="$dns" -v c="$conn" 'BEGIN { if (c > 0) printf "%.1f", (c - d) * 1000 }')
    [ $rc -eq 0 ] && resp=$(awk -v t="$total" 'BEGIN { printf "%.1f", t * 1000 }')
    echo "$ip|$lat|$resp|$err"
}

# --- JSON sections ---

json_system() {
    IFS='|' read -r host kernel up l1 l5 l15 model os <<< "$(get_system_info)"
    printf '  "system": {"hostname": "%s", "kernel": "%s", "os": "%s", "cpu_model": "%s", "uptime_s": %s, "loadavg": [%s, %s, %s]}' \
        "$(json_escape "$host")" "$(json_escape "$kernel")" "$(json_escape "$os")" "$(json_escape "$model")" \
        "${up:-0}" "${l1:-0}" "${l5:-0}" "${l15:-0}"
}

json_cpu() {
    local mhz stats total loads=() i
    mapfile -t mhz < <(get_cpu_mhz)
    while read -r name val; do
        if [ "$name" == "cpu" ]; then total=$val; else loads+=("$val"); fi
    done < <(get_cpu_stats)

    echo -n "  \"cpu_mhz\": ["
    for ((i=0; i<${#mhz[@]}; i++)); do
        printf '"%s"%s' "${mhz[$i]}" "$([ $i -lt $((${#mhz[@]}-1)) ] && echo ',')"
    done
    echo "],"
    echo -n "  \"cpu_load\": ["
    for ((i=0; i<${#loads[@]}; i++)); do
        printf '"%s"%s' "${loads[$i]}" "$([ $i -lt $((${#loads[@]}-1)) ] && echo ',')"
    done
    echo "],"
    printf '  "cpu_total": "%s"' "${total:-0.0}"
}

json_temp() {
    local temp_raw count i label val
    mapfile -t temp_raw < <(get_cpu_temp)
    echo "  \"temperatures\": {"
    count=${#temp_raw[@]}
    for ((i=0; i<$count; i++)); do
        IFS='|' read -r label val <<< "${temp_raw[$i]}"
        printf "    \"%s\": \"%s\"%s\n" "$(json_escape "$label")" "$val" "$([ $i -lt $((count-1)) ] && echo ',')"
    done
    echo -n "  }"
}

json_mem() {
    local mem bytes
    mem=($(get_mem_info))
    bytes=($(get_mem_bytes))
    printf '  "memory": {"total": "%s", "used": "%s", "available": "%s", "total_bytes": %s, "used_bytes": %s, "free_bytes": %s, "cache_bytes": %s, "available_bytes": %s, "swap_total_bytes": %s, "swap_used_bytes": %s}' \
        "${mem[0]}" "${mem[1]}" "${mem[2]}" \
        "${bytes[0]:-0}" "${bytes[1]:-0}" "${bytes[2]:-0}" "${bytes[3]:-0}" "${bytes[4]:-0}" "${bytes[5]:-0}" "${bytes[6]:-0}"
}

json_disk() {
    local disk_cap fs_raw count i dev type size used avail mnt
    disk_cap=($(get_disk_usage))
    mapfile -t fs_raw < <(get_filesystems)
    echo "  \"disk_usage\": {\"total\": \"${disk_cap[0]}\", \"used\": \"${disk_cap[1]}\", \"free\": \"${disk_cap[2]}\"},"
    echo "  \"filesystems\": ["
    count=${#fs_raw[@]}
    for ((i=0; i<$count; i++)); do
        IFS='|' read -r dev type size used avail mnt <<< "${fs_raw[$i]}"
        printf '    {"device": "%s", "fstype": "%s", "mount": "%s", "total_bytes": %s, "used_bytes": %s, "free_bytes": %s}%s\n' \
            "$(json_escape "$dev")" "$(json_escape "$type")" "$(json_escape "$mnt")" "$size" "$used" "$avail" \
            "$([ $i -lt $((count-1)) ] && echo ',')"
    done
    echo -n "  ]"
}

json_gpu() {
    local gpu_raw count i gname gtemp gpwr gutil gidx mused mtotal plimit fan pstate driver
    mapfile -t gpu_raw < <(get_gpu_info)
    echo "  \"gpus\": ["
    count=${#gpu_raw[@]}
    for ((i=0; i<$count; i++)); do
        IFS='|' read -r gname gtemp gpwr gutil gidx mused mtotal plimit fan pstate driver <<< "${gpu_raw[$i]}"
        printf '    {"id": %d, "name": "%s", "temp": "%s", "power": "%s", "utilization": "%s", "memory_used_bytes": %s, "memory_total_bytes": %s, "power_limit_w": %s, "fan_percent": %s, "pstate": "%s", "driver": "%s"}%s\n' \
            "${gidx:-$i}" "$(json_escape "$gname")" "$gtemp" "$gpwr" "$gutil" \
            "${mused:-null}" "${mtotal:-null}" "${plimit:-null}" "${fan:-null}" \
            "$(json_escape "$pstate")" "$(json_escape "$driver")" \
            "$([ $i -lt $((count-1)) ] && echo ',')"
    done
    echo -n "  ]"
}

json_diskio() {
    local disk_raw count i dev rd wr rbps wbps util
    mapfile -t disk_raw < <(get_disk_io)
    echo "  \"disk_io\": ["
    count=${#disk_raw[@]}
    for ((i=0; i<$count; i++)); do
        IFS='|' read -r dev rd wr rbps wbps util <<< "${disk_raw[$i]}"
        echo "    {\"device\": \"$dev\", \"read\": \"$rd\", \"write\": \"$wr\", \"read_bps\": $rbps, \"write_bps\": $wbps, \"active_percent\": $util}$([ $i -lt $((count-1)) ] && echo ',')"
    done
    echo -n "  ]"
}

json_net() {
    local net_raw count i iface rx tx rxb txb rxt txt state speed ipv4
    mapfile -t net_raw < <(get_net_io)
    echo "  \"net_io\": ["
    count=${#net_raw[@]}
    for ((i=0; i<$count; i++)); do
        IFS='|' read -r iface rx tx rxb txb rxt txt state speed ipv4 <<< "${net_raw[$i]}"
        printf '    {"interface": "%s", "rx": "%s", "tx": "%s", "rx_bps": %s, "tx_bps": %s, "rx_total_bytes": %s, "tx_total_bytes": %s, "state": "%s", "speed_mbit": %s, "ipv4": "%s"}%s\n' \
            "$(json_escape "$iface")" "$rx" "$tx" "$rxb" "$txb" "$rxt" "$txt" "$state" "$speed" "$ipv4" \
            "$([ $i -lt $((count-1)) ] && echo ',')"
    done
    echo -n "  ]"
}

json_wan() {
    local ip lat resp err
    IFS='|' read -r ip lat resp err <<< "$(get_wan_info)"
    printf '  "wan": {"ip": "%s", "latency_ms": %s, "response_ms": %s, "error": "%s", "url": "%s"}' \
        "$ip" "${lat:-null}" "${resp:-null}" "$err" "$(json_escape "$WAN_URL")"
}

json_smart() {
    local raw ver err count i
    local dev kind model serial fw cap rpm health temp poh cyc rd wr lu sp spt rel pend unc unused media unsafe rem basis state derr
    mapfile -t raw < <(get_smart_info)
    IFS='|' read -r ver err <<< "${raw[0]}"
    printf '  "smart": {"smartctl": "%s", "error": "%s", "design_hours": %s, "devices": [\n' \
        "$(json_escape "$ver")" "$err" "${SMART_DESIGN_HOURS:-null}"
    count=$(( ${#raw[@]} - 1 ))
    for ((i=1; i<=count; i++)); do
        IFS='|' read -r dev kind model serial fw cap rpm health temp poh cyc rd wr lu sp spt rel pend unc unused media unsafe rem basis state derr <<< "${raw[$i]}"
        printf '    {"device": "%s", "kind": "%s", "model": "%s", "serial": "%s", "firmware": "%s", "capacity_bytes": %s, "rpm": %s, "health": "%s", "temp_c": %s, "power_on_hours": %s, "power_cycles": %s, "read_bytes": %s, "written_bytes": %s, "life_used_percent": %s, "spare_percent": %s, "spare_threshold_percent": %s, "reallocated_sectors": %s, "pending_sectors": %s, "uncorrectable_sectors": %s, "unused_reserve_blocks": %s, "media_errors": %s, "unsafe_shutdowns": %s, "life_remaining_hours": %s, "life_basis": "%s", "state": "%s", "error": "%s"}%s\n' \
            "$(json_escape "$dev")" "$kind" "$(json_escape "$model")" "$(json_escape "$serial")" "$(json_escape "$fw")" \
            "${cap:-null}" "${rpm:-null}" "$(json_escape "$health")" "${temp:-null}" "${poh:-null}" "${cyc:-null}" \
            "${rd:-null}" "${wr:-null}" "${lu:-null}" "${sp:-null}" "${spt:-null}" "${rel:-null}" "${pend:-null}" \
            "${unc:-null}" "${unused:-null}" "${media:-null}" "${unsafe:-null}" "${rem:-null}" "$basis" "$state" "$derr" \
            "$([ $i -lt $count ] && echo ',')"
    done
    echo -n "  ]}"
}

# --- Output Logic ---

if [ "$1" == "json" ]; then
    shift
    sections=("$@")
    [ ${#sections[@]} -eq 0 ] && sections=(system cpu temp mem disk gpu diskio net)

    # Rate values need a previous reading - take one and wait briefly on first use.
    primed=0
    for s in "${sections[@]}"; do
        if [ "$s" == "diskio" ] && [ ! -f "$DISK_STATE" ]; then get_disk_io > /dev/null; primed=1; fi
        if [ "$s" == "net" ] && [ ! -f "$NET_STATE" ]; then get_net_io > /dev/null; primed=1; fi
    done
    [ $primed -eq 1 ] && sleep 0.5

    parts=()
    for s in "${sections[@]}"; do
        case "$s" in
            system) parts+=("$(json_system)") ;;
            cpu)    parts+=("$(json_cpu)") ;;
            temp)   parts+=("$(json_temp)") ;;
            mem)    parts+=("$(json_mem)") ;;
            disk)   parts+=("$(json_disk)") ;;
            gpu)    parts+=("$(json_gpu)") ;;
            diskio) parts+=("$(json_diskio)") ;;
            net)    parts+=("$(json_net)") ;;
            wan)    parts+=("$(json_wan)") ;;
            smart)  parts+=("$(json_smart)") ;;
            *)      echo "sysinfo: unknown section '$s'" >&2; exit 2 ;;
        esac
    done

    echo "{"
    printf '  "timestamp": %s' "$(date +%s.%N)"
    for p in "${parts[@]}"; do
        printf ',\n%s' "$p"
    done
    printf '\n}\n'

else
    # Hide cursor for a cleaner UI, restore it on exit.
    # Only here: in JSON mode the escape codes would end up in front of the "{".
    trap 'tput cnorm; rm -f "$DISK_STATE" "$NET_STATE"; exit' INT TERM
    tput civis

    clear
    while true; do
        tput cup 0 0
        echo -e "\e[1;34m--- DGX Spark System Information ---\e[0m"

        # GPU Info
        echo -e "\n\e[1mGPU Status:\e[0m"
        gpu_data=$(get_gpu_info)
        if [ -z "$gpu_data" ]; then
            echo "  No NVIDIA GPUs detected"
        else
            echo "$gpu_data" | awk -F'|' '{printf "  GPU %d: %-15s | Temp: %-4s | Pwr: %-5s | Util: %-4s\n", NR-1, $1, $2, $3, $4}'
        fi

        echo -e "\n\e[1mMemory Usage:\e[0m"
        mem=($(get_mem_info))
        printf "  %-10s %s\n" "Total:" "${mem[0]}"
        printf "  %-10s %s\n" "Used:" "${mem[1]}"
        printf "  %-10s %s\n" "Available:" "${mem[2]}"

        echo -e "\n\e[1mCPU Load & Speed:\e[0m"
        # Combine load and mhz for a compact view
        load_arr=($(get_cpu_load))
        mhz_arr=($(get_cpu_mhz))
        for i in "${!load_arr[@]}"; do
            printf "  Core %-2d: %5s%% @ %s MHz\n" "$i" "${load_arr[$i]}" "${mhz_arr[$i]}"
        done | head -n 16 # Limit to 16 cores to prevent screen overflow, remove head to see all

        echo -e "\n\e[1mDisk Capacity & I/O:\e[0m"
        get_filesystems | awk -F'|' '{
            printf "  %-20s %8.1f GB (Used: %.1f GB, Free: %.1f GB)\033[K\n", $6 ":", $3/1073741824, $4/1073741824, $5/1073741824
        }'

        disk_results=$(get_disk_io)
        if [ $? -ne 0 ]; then
            echo "  Detecting drives..."
        else
            echo "$disk_results" | awk -F'|' '{printf "  %-8s Read: %-12s Write: %-12s Active: %5s%%\033[K\n", $1 ":", $2, $3, $6}'
        fi

        echo -e "\n\e[1mNetwork:\e[0m"
        net_results=$(get_net_io)
        if [ $? -ne 0 ]; then
            echo "  Detecting interfaces..."
        else
            echo "$net_results" | awk -F'|' '{printf "  %-10s Down: %-16s Up: %-16s %s\033[K\n", $1 ":", $2, $3, $10}'
        fi

        echo -e "\n\e[1;34m------------------------------------\e[0m"
        sleep 1
    done
fi
